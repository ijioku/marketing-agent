# Copy this file to ".env" and fill it in.

# Dashboard password. Use 10+ characters before going online (the app refuses to start in production with a weak one).
ADMIN_PASSWORD=changeme
# The port the server listens on locally.
PORT=3000
# Optional: your own email as the main admin, so you can sign in with it (password or Google).
ADMIN_EMAIL=

# Optional: "Continue with Google" on the sign-in page. Free: console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID → Web application → add your site under Authorized JavaScript origins. Paste the Client ID here.
GOOGLE_CLIENT_ID=

# Optional: the email shown on /privacy and /terms for questions and data requests.
SUPPORT_EMAIL=

# AI provider (any OpenAI-compatible API). Leave AI_API_KEY empty to run in free offline mode.
# Groq (free tier) — get a key at https://console.groq.com/keys  (see available models: console.groq.com/docs/models)
# The AI provider's address (Groq by default).
AI_BASE_URL=https://api.groq.com/openai/v1
# Which AI model to use.
AI_MODEL=openai/gpt-oss-120b
# Your secret AI key (empty = offline mode).
AI_API_KEY=

# Alternatives:
# Google Gemini (free tier):  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.5-flash
# OpenRouter (has free models): AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=<pick a ":free" model on openrouter.ai/models>

# ---------- Email campaigns ----------
# log    = TEST mode. Nothing is sent; emails are saved to data/outbox.json. (default)
# brevo  = free tier, verify one sender address:  https://www.brevo.com   (EMAIL_API_KEY = an API v3 key)
# resend = free tier, needs your own domain:       https://resend.com      (EMAIL_API_KEY = re_...)
# Which email mode to use: log, brevo or resend.
EMAIL_PROVIDER=log
# The email provider's secret API key.
EMAIL_API_KEY=
# The address emails are sent from (must be verified with the provider).
EMAIL_FROM_ADDRESS=
# Public address of this server, used in unsubscribe links. Must be reachable online when sending for real.
PUBLIC_URL=http://localhost:3000
# Go slow at first so inbox providers trust you. Raise gradually (e.g. 50 → 100 → 200/day).
# At most this many emails per business per day.
SEND_DAILY_LIMIT=50
# Wait this many milliseconds between emails.
SEND_DELAY_MS=1500

# ---------- Going online ----------
# NODE_ENV=production   turns on the strong-password check
# TRUST_PROXY=1         set this when hosting behind a proxy (Render, Railway, Fly.io) so login lockout sees real visitor IPs

# ---------- WhatsApp & Instagram auto-replies (Meta) ----------
# Leave empty until you connect a Meta app. Without access tokens, replies are saved to
# data/social_outbox.json instead of being sent (test mode). See README → "WhatsApp & Instagram setup".
# Your Meta app secret: proves webhook calls really come from Meta.
META_APP_SECRET=
# A word you choose and also type into Meta, so Meta can confirm the webhook is yours.
META_VERIFY_TOKEN=
# The version of Meta's API to use.
META_GRAPH_VERSION=v21.0
# Lets the app send WhatsApp replies.
WHATSAPP_ACCESS_TOKEN=
# Which WhatsApp phone-number ID belongs to which business: phone_number_id:business-id,...
WHATSAPP_ROUTES=
# Lets the app send Instagram replies.
INSTAGRAM_ACCESS_TOKEN=
# Which Instagram account ID belongs to which business: instagram_account_id:business-id,...
INSTAGRAM_ROUTES=

# ---------- Follow-ups ----------
# Inquiries still "new" after this many hours are flagged with ⏰ in the dashboard.
FOLLOW_UP_AFTER_HOURS=24

# ---------- Deployment ----------
# Free hosting (Render/Vercel/etc. wipe files on restart): use a free Postgres database instead, e.g. Neon.
# When DATABASE_URL is set, all data is stored there and DATA_DIR is ignored.
DATABASE_URL=

# Or, on a host with a persistent disk: folder where customer data and business profiles are kept.
# Leave empty locally (uses ./data). On Railway/Render/Fly, mount a volume and set e.g. DATA_DIR=/data
DATA_DIR=
